---
// Fullscreen viewer for every `[data-lightbox]` link on the page.
// Without JavaScript the links simply open the large image.
---

<dialog class="lightbox" aria-label="Image viewer">
  <figure><img alt="" /></figure>
  <button class="lb-close" type="button" aria-label="Close">&times;</button>
  <button class="lb-prev" type="button" aria-label="Previous image">&#8249;</button>
  <button class="lb-next" type="button" aria-label="Next image">&#8250;</button>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('dialog.lightbox');
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-lightbox]')];

  if (dialog && links.length) {
    const img = dialog.querySelector('img')!;
    let index = 0;

    const show = (i: number) => {
      index = (i + links.length) % links.length;
      const link = links[index];
      img.src = link.href;
      img.alt = link.querySelector('img')?.alt ?? '';
      // Preload neighbours so arrows feel instant.
      for (const j of [index + 1, index - 1]) new Image().src = links[(j + links.length) % links.length].href;
    };

    links.forEach((link, i) =>
      link.addEventListener('click', (e) => {
        if (e.metaKey || e.ctrlKey || e.shiftKey) return;
        e.preventDefault();
        show(i);
        dialog.showModal();
      }),
    );

    const multiple = links.length > 1;
    dialog.querySelectorAll<HTMLElement>('.lb-prev, .lb-next').forEach((b) => (b.hidden = !multiple));
    dialog.querySelector('.lb-close')!.addEventListener('click', () => dialog.close());
    dialog.querySelector('.lb-prev')!.addEventListener('click', () => show(index - 1));
    dialog.querySelector('.lb-next')!.addEventListener('click', () => show(index + 1));
    dialog.querySelector('figure')!.addEventListener('click', (e) => e.target !== img && dialog.close());
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });

    let touchX = 0;
    dialog.addEventListener('touchstart', (e) => (touchX = e.touches[0].clientX), { passive: true });
    dialog.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - touchX;
      if (multiple && Math.abs(dx) > 50) show(index + (dx < 0 ? 1 : -1));
    });
  }
</script>
